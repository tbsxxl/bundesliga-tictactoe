{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bundesliga-tictactoe",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Worker nur für die API aufrufen – statische Dateien kommen direkt vom CDN.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
